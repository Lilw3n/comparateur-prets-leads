// Copie « Vercel / Neon » : PostgreSQL. Synchroniser les modèles avec schema.sqlite.prisma.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum TierRank {
  S
  A
  B
  C
  D
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LinkSuggestionKind {
  LIST_FULL
  LIST_ITEM
  HOME_TEASER
}

model User {
  id                       String           @id @default(cuid())
  email                    String           @unique
  name                     String?
  passwordHash             String
  role                     Role             @default(USER)
  tierLists                TierList[]
  tierVotes                TierListVote[]
  linkSuggestionsSubmitted LinkSuggestion[] @relation("SubmittedSuggestions")
  linkSuggestionsReviewed  LinkSuggestion[] @relation("ReviewedSuggestions")
  musicPlaylistsCreated    MusicPlaylist[]
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
}

model TierList {
  id              String           @id @default(cuid())
  title           String
  description     String?
  anime           String?
  category        String
  resourceUrl     String?
  createdById     String
  createdBy       User             @relation(fields: [createdById], references: [id], onDelete: Cascade)
  items           TierListItem[]
  votes           TierListVote[]
  linkSuggestions LinkSuggestion[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model TierListItem {
  id              String           @id @default(cuid())
  tierListId      String
  tierList        TierList         @relation(fields: [tierListId], references: [id], onDelete: Cascade)
  label           String
  rank            TierRank
  linkUrl         String?
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  linkSuggestions LinkSuggestion[]

  @@index([tierListId, rank, sortOrder])
}

model TierListVote {
  id         String   @id @default(cuid())
  tierListId String
  userId     String
  value      Int      @default(1)
  tierList   TierList @relation(fields: [tierListId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([tierListId, userId])
}

model SiteConfig {
  id            Int      @id
  liveTvEnabled Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

model LinkSuggestion {
  id               String              @id @default(cuid())
  kind             LinkSuggestionKind  @default(LIST_FULL)
  tierListId       String?
  tierListItemId   String?
  url              String
  title            String?
  note             String?
  status           SuggestionStatus    @default(PENDING)
  submittedById    String
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime            @default(now())

  tierList     TierList?     @relation(fields: [tierListId], references: [id], onDelete: Cascade)
  tierListItem TierListItem? @relation(fields: [tierListItemId], references: [id], onDelete: Cascade)
  submittedBy  User          @relation("SubmittedSuggestions", fields: [submittedById], references: [id], onDelete: Cascade)
  reviewedBy   User?         @relation("ReviewedSuggestions", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([tierListId, status])
  @@index([tierListItemId, status])
  @@index([kind, status])
}

model MusicPlaylist {
  id          String   @id @default(cuid())
  label       String
  url         String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
