# Base locale = fichier SQLite (aucun serveur à installer)
DATABASE_URL="file:./prisma/dev.db"

# Auth.js — openssl rand -base64 32
AUTH_SECRET="remplace-par-une-chaine-longue-et-aleatoire"

# Même URL + port que dans la barre du navigateur (souvent http://localhost:3000)
AUTH_URL="http://localhost:3000"

ADMIN_EMAIL="ton-email@example.com"

# Une fois : crée le compte admin (même email + mot de passe que tu utiliseras sur /login)
# BOOTSTRAP_ADMIN_EMAIL="ton-email@example.com"
# BOOTSTRAP_ADMIN_PASSWORD="au_moins_8_caracteres"
# Puis : npx prisma db push && npm run bootstrap-admin
# Puis supprime BOOTSTRAP_ADMIN_PASSWORD.

